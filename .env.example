# Copy this file to .env (for your laptop) or add these in Vercel > Settings > Environment Variables.
# NEVER share your real key or put it inside index.html.

# From https://aistudio.google.com/apikey (leave empty for demo mode)
GEMINI_API_KEY=

# Optional: which Gemini model to use
GEMINI_MODEL=gemini-flash-latest

# A secret number teachers type to reset the scoreboard
ADMIN_PIN=

# Filled in automatically by Vercel when you connect an Upstash Redis database
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
